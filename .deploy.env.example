# Copy this file to .deploy.<target>.env — one file per deployment target,
# e.g. .deploy.wallyai.env and .deploy.active-tangent.env.
# Run commands as: ./deploy.sh <target> <command>
# .deploy.*.env files are gitignored — never commit them.

# GCP project where the service lives
PROJECT_ID=your-gcp-project-id

# Region for Cloud Run and Artifact Registry
REGION=europe-west1

# Cloud Run service name (one per deployment is typical)
SERVICE=octocode-mcp

# Artifact Registry repository name (created during setup)
REPO=mcp

# Service account used by the Cloud Run container at runtime
RUNTIME_SA=mcp-runtime@your-gcp-project-id.iam.gserviceaccount.com

# Secret Manager secret that holds the GitHub personal access token
# (use a dedicated machine-user PAT with minimal scopes: repo, read:user, read:org)
# Each project needs its own copy of the secret. Create once with:
#   printf '%s' 'ghp_...' | gcloud secrets create octocode-github-token \
#     --data-file=- --project="$PROJECT_ID"
SECRET_NAME=octocode-github-token

# Optional: the gcloud account that has access to this project. Useful when
# different targets live under different Google accounts. Leave unset to use
# whatever account is active in gcloud.
#GCLOUD_ACCOUNT=you@example.com
